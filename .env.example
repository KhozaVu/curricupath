GEMINI_API_KEY=replace-with-your-local-key
GEMINI_MODEL=gemini-3.6-flash
REASONING_REVIEWER_ENABLED=false
REASONING_REVIEWER_MODEL=gemini-3.6-flash
REASONING_REVIEWER_TIMEOUT_MS=5000
HANDBOOK_RAG_DEMO_ENABLED=false
# Used only by the live comparison toggle, not formal evaluation runs.
HANDBOOK_RAG_DEMO_MODEL=gemini-3.5-flash-lite
HF_TOKEN=replace-with-your-hugging-face-inference-token
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
SEMANTIC_SEARCH_ENABLED=true
PUBLIC_COURSE_RANKER_ENABLED=false
PUBLIC_COURSE_RANKER_MODEL=experiments/models/public_course_pairwise_logistic_v1.json
ALLOW_EXPERIMENTAL_RANKER=false
POSTGRES_DB=curricupath
POSTGRES_USER=curricupath
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://curricupath:replace-with-a-local-development-password@127.0.0.1:5432/curricupath
CATALOGUE_BACKEND=postgresql
CATALOGUE_CSV_FALLBACK=true
